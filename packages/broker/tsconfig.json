{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true, "strictNullChecks": false,
    "noImplicitAny": false, "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "declaration": true, "skipLibCheck": true,
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
