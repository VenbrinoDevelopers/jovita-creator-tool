{
  "name": "@jovita-ai/cli",
  "version": "0.1.8",
  "description": "Create, test, build, and submit Jovita apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VenbrinoDevelopers/jovita-creator-tool.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "jov": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/{manifest,runtime,artifacts,bundle-size,creator-api,sdk-project}.test.ts"
  },
  "dependencies": {
    "@jovita-ai/sdk": "0.1.6",
    "commander": "^14.0.3",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.9.3"
  }
}
